 const roof=new T.Mesh(geo,new T.MeshStandardMaterial({color:'#9eb6c2',side:T.DoubleSide,transparent:true,opacity:.24,depthWrite:false}));roof.position.y=y+.03;roof.userData.layer='provisionalRoof';group.add(roof);
 const points=[...ps,ps[0]].map(q=>new T.Vector3(q[0],y+.04,q[1]));const border=new T.Line(new T.BufferGeometry().setFromPoints(points),new T.LineDashedMaterial({color:'#edbd62',dashSize:.3,gapSize:.18,transparent:true,opacity:.85}));border.computeLineDistances();border.userData.layer='provisionalRoof';group.add(border);
