// Common post-generation checks for every imported drawing, not building-specific fixes.
function checkModelQuality(pages,network){
 const issues=[],floors=pages.filter(p=>p.included),seen=new Set();
 if(!floors.length)issues.push('층별 구조 미생성: 원본 추출만 완료된 상태');
 for(const p of floors){
  const key=p.building+' '+p.floor+'층';if(seen.has(key))issues.push(key+': 기준 도면 중복');seen.add(key);
  if(!(p.scale>0))issues.push(key+': 축척 누락');
  if(!p.floorOutline?.length)issues.push(key+': 바닥 경계 미확정');
  if(!p.shapes?.some(s=>s.type==='wall'))issues.push(key+': 벽체 누락');
  for(const door of (p.shapes||[]).filter(s=>s.type==='door')){
   const dx=door.b[0]-door.a[0],dz=door.b[1]-door.a[1],length=Math.hypot(dx,dz);if(!length)continue;
   const supported=(p.shapes||[]).some(w=>{if(w.type!=='wall')return false;const wx=w.b[0]-w.a[0],wz=w.b[1]-w.a[1],len=Math.hypot(wx,wz);if(!len)return false;return [door.a,door.b].every(q=>{const along=((q[0]-w.a[0])*wx+(q[1]-w.a[1])*wz)/len;const across=Math.abs((q[0]-w.a[0])*wz-(q[1]-w.a[1])*wx)/len;return across*p.scale<.4&&along>=-.01&&along<=len+.01;});});
   if(!supported)issues.push(key+': 벽 연결이 없는 출입구 · 원본 대조 필요');
  }

  if(p.fireFacilities?.pipes?.length&&!p.fireFacilities?.risers?.length&&floors.length>1)issues.push(key+': 입상 위치 근거 누락');
 }
 if(network){const nodes=new Map(network.nodes.map(n=>[n.id,n]));
  for(const e of network.pipes){const a=nodes.get(e.from),b=nodes.get(e.to);if(!a||!b){issues.push('배관 끝점 누락');continue;}
   if([b.x-a.x,b.y-a.y,b.z-a.z].filter(v=>Math.abs(v)>.0002).length>1&&!(e.geometryType==='drawing-diagonal'&&e.sourcePage))issues.push('수평·수직 기준에서 벗어난 배관: '+e.id+' · 도면 근거 확인 필요');
   if(a.floor!==b.floor&&(Math.abs(a.x-b.x)>.001||Math.abs(a.z-b.z)>.001))issues.push('층간 배관이 기울어짐: '+e.id+' · 수평/수직 분리 필요');
   if(a.floor!==b.floor&&(!a.riserId||a.riserId!==b.riserId))issues.push('층간 입상관 식별 근거 누락: '+e.id);
  }
  issues.push(...(network.riserIssues||[]),...(network.geometryIssues||[]));
 }
 return [...new Set(issues)];
}
if(typeof module!=='undefined')module.exports={checkModelQuality};
else (function(){
 const panel=document.createElement('details');panel.id='modelQuality';panel.innerHTML='<summary>자동 모델 검사</summary><p style="font-size:12px;line-height:1.6"></p>';document.getElementById('workspacePanel').append(panel);
 function update(network){const issues=checkModelQuality(state.pages,network);panel.querySelector('p').textContent=issues.length?issues.join(' / '):'기본 형상 검사 통과 · 원본과의 일치 및 미판독 설비까지 보증하는 검사는 아닙니다.';}
 window.addEventListener('hydraulic-selection',e=>update(e.detail.network));update(window.HydraulicUI?.getNetwork());
})();

// Default presentation of documented water supplies. Never invent equipment or positions.
(function(root){
 function supplyDefaults(pages,network){
  const equipment=pages.flatMap(p=>p.fireFacilities?.equipment||[]);
  const nodes=network?.nodes||pages.flatMap(p=>p.fireNetwork?.nodes||[]);
  const hasTank=equipment.some(e=>e.type==='tank')||nodes.some(n=>n.type==='tank');
  const hasPump=equipment.some(e=>e.type==='pump')||nodes.some(n=>n.type==='pump');
  return {hasTank,hasPump,source:hasTank&&hasPump?'tank':'inlet',colors:{pipe:'#ff465c',pump:'#a91e36',tank:'#ed8e9a'}};
 }
 if(typeof module!=='undefined')module.exports=supplyDefaults;
 root.waterSupplyDefaults=supplyDefaults;
 if(typeof document==='undefined'||typeof state==='undefined')return;
 let initialized=false;
 function apply(network){
  const config=supplyDefaults(state.pages.filter(p=>p.included),network);
  for(const [key,present]of [['waterPump',config.hasPump],['waterTank',config.hasTank]]){
   const input=document.querySelector('#waterComponentControls input[value="'+key+'"]');
   if(!input)continue;
   input.disabled=!present;
   if(!present){input.checked=false;root.reviewLayerVisibility={...root.reviewLayerVisibility,[key]:false};}
   input.parentElement.title=present?'등록된 설비를 층 선택과 함께 표시합니다.':'이 건물에 등록된 설비가 없어 적용하지 않습니다.';
  }
  const select=document.getElementById('waterFlowSource');
  if(select){select.querySelector('[value="tank"]').disabled=!(config.hasTank&&config.hasPump);
   if(!initialized||(!(config.hasTank&&config.hasPump)&&select.value==='tank')){root.waterFlowSource=config.source;select.value=config.source;}}
  initialized=true;
 }
 apply();
 root.addEventListener('hydraulic-selection',e=>apply(e.detail.network));
})(typeof window==='undefined'?globalThis:window);
